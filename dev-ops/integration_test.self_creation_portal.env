# -------------------------
# Application Configuration
# -------------------------
# Port on which the SCP application runs
APPLICATION_PORT=6001
# Hostname for the SCP application
APPLICATION_HOST=scp
# Environment type (development/production)
APPLICATION_ENV=development
# Base URL path for this service
APPLICATION_BASE_URL=/scp/

# -------------------------
# Token Settings
# -------------------------
# Token expiry time (units depend on implementation)
ACCESS_TOKEN_EXPIRY=1
# Internal use token (keep secret)
INTERNAL_ACCESS_TOKEN=PKXBJ7kgwX5auvASmB3djL8jd0pzYADo
# Secret for signing tokens
ACCESS_TOKEN_SECRET=hsghasghjab1273JHajnbabsjdj1273981273jhajksdh8y3123yhjkah812398yhjqwe7617237yuhdhhdqwu271

# -------------------------
# Kafka Configuration
# -------------------------
# Kafka broker URL
KAFKA_URL=kafka:9092
# Kafka consumer group ID for this service
KAFKA_GROUP_ID=scp
# Kafka topic for notifications
NOTIFICATION_KAFKA_TOPIC=dev.notifications
# Kafka topic for project publish events
PROJECT_PUBLISH_KAFKA_TOPIC=projectpublishtopic
# Toggle communications via Kafka
KAFKA_COMMUNICATIONS_ON_OFF=OFF
# Toggle resource Kafka push
RESOURCE_KAFKA_PUSH_ON_OFF=OFF

# -------------------------
# Cloud Storage Configuration
# -------------------------
# Cloud storage provider (e.g., aws)
CLOUD_STORAGE_PROVIDER=aws
# Cloud storage access key (masked)
CLOUD_STORAGE_ACCOUNTNAME=TES****
# Cloud storage secret key (masked)
CLOUD_STORAGE_SECRET=TESTF***
# S3 bucket name
CLOUD_STORAGE_BUCKETNAME=mentoring-prod-storage
# AWS region
CLOUD_STORAGE_REGION=ap-south-1
# Cloud storage endpoint
CLOUD_ENDPOINT=s3.ap-south-1.amazonaws.com

# -------------------------
# User Service Configuration
# -------------------------
# User service host and port
USER_SERVICE_HOST=http://user:3001
# User service base URL
USER_SERVICE_BASE_URL=/user/

# -------------------------
# GCP Configuration
# -------------------------
# Path to GCP credentials file
GCP_PATH=gcp.json

# -------------------------
# Redis Configuration
# -------------------------
# Redis server host and port
REDIS_HOST=redis:6379
# Key or prefix for clearing internal cache
CLEAR_INTERNAL_CACHE=scpInternal
# Internal cache expiration time (in seconds)
INTERNAL_CACHE_EXP_TIME=86400

# -------------------------
# Log Settings
# -------------------------
# Log level (e.g., silly, debug, info)
ERROR_LOG_LEVEL=silly
# Disable logging if true
DISABLE_LOG=false

# -------------------------
# JWT Configuration
# -------------------------
# Allowed host for JWT
ALLOWED_HOST=http://exampleDomain.com
# Authentication method (e.g., native, OAuth)
AUTH_METHOD=native

# -------------------------
# Database Configuration
# -------------------------
# Postgres connection string for development
DEV_DATABASE_URL=postgres://postgres:postgres@postgres:5432/integration_test_scp

# -------------------------
# Instance Level Configurations
# -------------------------
# If review is required for resources
REVIEW_REQUIRED=true
# Show reviewer list in UI
SHOW_REVIEWER_LIST=true
# Minimum approvals needed for review
MIN_APPROVAL=1
# Type of review process
REVIEW_TYPE=SEQUENTIAL
# Max tasks allowed per project
MAX_PROJECT_TASK_COUNT=10
# Supported resource types
RESOURCE_TYPES="project,observation,observation_with_rubric,survey,program"
# Service to use for consumption
CONSUMPTION_SERVICE=self
# Max body length for file uploads (in bytes)
MAX_BODY_LENGTH_FOR_UPLOAD=5242880
# Auto-save timer for resources (in ms)
RESOURCE_AUTO_SAVE_TIMER=1000
# Max note length for a resource
MAX_RESOURCE_NOTE_LENGTH=2000

# -------------------------
# API Endpoints
# -------------------------
# API endpoint for reading organization
ORGANIZATION_READ_ENDPOINT=v1/organization/read
# API endpoint for user list
USER_LIST_ENDPOINT=v1/account/search
# API endpoint for user profile details
USER_PROFILE_DETAILS_ENDPOINT=v1/user/read

# -------------------------
# Interface Service
# -------------------------
# Interface service host and port
INTERFACE_SERVICE_HOST=http://interface:5400

# -------------------------
# API Documentation URL
# -------------------------
# API documentation URL
API_DOC_URL=/api-doc

# -------------------------
# Reviewer Roles and Organization Defaults
# -------------------------
# Default reviewer role
DEFAULT_REVIEWER_ROLE=reviewer
# Default organization ID
DEFAULT_ORG_ID=default_code

# -------------------------
# Project/Observation Feature Toggles
# -------------------------
# Enable observation in projects
ENABLE_OBSERVATION_IN_PROJECTS=true

# -------------------------
# Regular Expressions
# -------------------------
# Regex to validate observation deep link
OBSERVATION_DEEP_LINK_REGEX="^https:\/\/dev\.elevate-ml\.shikshalokam\.org\/view\/observation\/[a-f0-9]{32}$"

# -------------------------
# Role and Permission Settings
# -------------------------
# Roles permitted to rollout resources
DEFAULT_ROLLOUT_ROLES='rollout_manager'
# Roles permitted to access dashboard
DEFAULT_DATA_MANAGERS="program_manager"
# Whether auth token is a bearer token
IS_AUTH_TOKEN_BEARER=true
# Endpoint for presigned URLs
CONSUMPTION_SERVICE_PRESIGNED_URL='v1/cloud-services/files/preSignedUrls'
# Roles allowed to design programs
DEFAULT_PROGRAM_DESIGNER_ROLES="program_designer"
# Kafka topic for rollout publish
ROLLOUT_PUBLISH_KAFKA_TOPIC='dev.rolloutpublish'
# Program manager roles
DEFAULT_PROGRAM_MANAGERS="program_manager"
# Resource types not allowed to be rejected
NON_REJECTABLE_RESOURCE_TYPES="program"
# Require review after publish
REVIEW_REQUIRED_AFTER_PUBLISH=true
# Kafka topic for program publish
PROGRAM_PUBLISH_KAFKA_TOPIC=dev.programpublish

# -------------------------
# Entity Hierarchy & Admin Roles
# -------------------------
# Highest entity in the hierarchy
HIGHEST_IN_ENTITY_HIERARCHY=state
# Default admin role
DEFAULT_ADMIN_ROLE=admin
# Default org admin role
DEFAULT_ORG_ADMIN_ROLE=org_admin
# Default content creator role
DEFAULT_CONTENT_CREATOR_ROLE=content_creator

# -------------------------
# Auth & Headers
# -------------------------
# Whether to use Bearer for auth token
IS_AUTH_TOKEN_BEARER=false
# HTTP header for auth token
AUTH_TOKEN_HEADER_NAME='x-auth-token'
# HTTP header for organization ID
ORG_ID_HEADER_NAME='organization-id'
# HTTP header for tenant ID
TENANT_ID_HEADER_NAME='tenant-id'
# Default organization code
DEFAULT_ORGANISATION_CODE='default_code'
# Default tenant code
DEFAULT_TENANT_CODE='default'
# Auth config file path
AUTH_CONFIG_FILE_PATH='config.json'

# -------------------------
# Session Verification
# -------------------------
# Uncomment to set session verification method
#SESSION_VERIFICATION_METHOD='user_service_authenticated'
# Session verification method toggle
SESSION_VERIFICATION_METHOD=false