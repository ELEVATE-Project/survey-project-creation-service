CLOUD_ENDPOINT=s3.ap-south-1.amazonaws.com

# User Service Configuration
USER_SERVICE_HOST=http://user:5001
USER_SERVICE_BASE_URL=/user/

# GCP Configuration
GCP_PATH=gcp.json

# Redis Configuration
REDIS_HOST=redis:6379
CLEAR_INTERNAL_CACHE=scpInternal
INTERNAL_CACHE_EXP_TIME=86400

# Log Settings
ERROR_LOG_LEVEL=silly
DISABLE_LOG=false

# JWT Configuration
ALLOWED_HOST=http://exampleDomain.com
AUTH_METHOD=jwt_only

# Database Configuration
DEV_DATABASE_URL=postgres://postgres:postgres@postgres:5432/integration_test_scp

# Instance Level Config
REVIEW_REQUIRED=true
SHOW_REVIEWER_LIST=true
MIN_APPROVAL=1
REVIEW_TYPE=SEQUENTIAL
MAX_PROJECT_TASK_COUNT=10
RESOURCE_TYPES="project,observation,observation_with_rubric,survey,program"
CONSUMPTION_SERVICE=self
MAX_BODY_LENGTH_FOR_UPLOAD=5242880
RESOURCE_AUTO_SAVE_TIMER=1000
MAX_RESOURCE_NOTE_LENGTH=2000

# API Endpoints
ORGANIZATION_READ_ENDPOINT=v1/organization/read
USER_LIST_ENDPOINT=v1/account/search
USER_PROFILE_DETAILS_ENDPOINT=v1/user/read

# Interface Service
INTERFACE_SERVICE_HOST=http://interface:5400

# API Documentation URL
API_DOC_URL=/api-doc

# Reviewer Role
DEFAULT_REVIEWER_ROLE=reviewer

#Default org
DEFAULT_ORG_ID=1
DEFAULT_ORGANISATION_CODE=default_code

# If the service allow observation make this true else false
ENABLE_OBSERVATION_IN_PROJECTS=true

# Regular expression to validate observation deep link
OBSERVATION_DEEP_LINK_REGEX= "^https:\/\/dev\.elevate-ml\.shikshalokam\.org\/view\/observation\/[a-f0-9]{32}$"

#Role name which have permission to rollout the resourced
DEFAULT_ROLLOUT_ROLES='rollout_manager'

# detault data manager roles - Roles designated to access dashboard in the consumption side 
DEFAULT_DATA_MANAGERS="program_manager"

#Indicate If auth token is bearer or not
IS_AUTH_TOKEN_BEARER=true

CONSUMPTION_SERVICE_PRESIGNED_URL='v1/cloud-services/files/preSignedUrls'

#Role name which have permission to create program
DEFAULT_PROGRAM_DESIGNER_ROLES="program_designer"

#kafka topic for publishing rollout
ROLLOUT_PUBLISH_KAFKA_TOPIC='dev.rolloutpublish'

# detault program manager roles - Roles designated to access dashboard in the consumption side 
DEFAULT_PROGRAM_MANAGERS="program_manager"

# Resource types that cannot be rejected in a review.
NON_REJECTABLE_RESOURCE_TYPES="program"

#Indicate review is required after publish
REVIEW_REQUIRED_AFTER_PUBLISH=true

#Program publish kafka topic
PROGRAM_PUBLISH_KAFKA_TOPIC=dev.programpublish

